{
  "name": "shared-grocery-spending-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot for tracking shared grocery spending within custom salary-to-salary budget windows",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:trivy": "trivy fs --severity HIGH,CRITICAL --exit-code 1 .",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "predeploy": "npm run typecheck && npm run test:coverage && npm run security:audit && tsc",
    "deploy": "npm run predeploy && fly deploy"
  },
  "overrides": {
    "gaxios": "^7.3.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "grammy": "^1.34.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
